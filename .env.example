# 说明可选 MLflow 与 OSS 环境变量；此模板不会被应用自动加载。
# 可通过 uv run --env-file .env 显式注入，真实 .env 必须保持忽略。
# 填写带 https:// 等协议的完整 Tracking URI，不要只写裸主机名。
MLFLOW_TRACKING_URI=

# 参数/指标和代理归档只需服务认证；按实际认证方式选择，不要求同时填三项。
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
MLFLOW_TRACKING_TOKEN=

# 仅 direct 归档使用：OSS 的 S3 兼容 endpoint 与存储凭据。
# off/proxy 不要求这些变量，代理的 OSS 凭据由服务端管理。
MLFLOW_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=
